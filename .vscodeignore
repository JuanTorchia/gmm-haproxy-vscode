**/.git/**
**/.github/**
**/node_modules/**
**/src/**
**/*.test.ts
**/*.map
**/*.tsbuildinfo
**/*.d.ts
test/**
coverage/**
docs/**
out/**
.claude/**
scripts/**
eslint.config.js
tsconfig*.json
jest.config.js
CLAUDE.md
AGENTS.md
.gitignore
*.log
*.vsix
**/*.vsix
gmm-haproxy-vscode-*.vsix
**/package-lock.json
**/pnpm-lock.yaml
pnpm-workspace.yaml
**/yarn.lock
client/tsconfig.json
server/tsconfig.json

# Never package local credentials or private deployment material.
.env
.env.*
!.env.example
serviceaccount.json
service-account.json
serviceaccout.json
credentials.json
firebase-adminsdk*.json
google-application-credentials*.json
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.kubeconfig

# Repo-only docs. README links to them are rewritten to GitHub URLs by vsce.
ROADMAP.md
SECURITY.md
SUPPORT.md
GOOD_FIRST_ISSUES.md
CONTRIBUTING.md
CODE_OF_CONDUCT.md
images/icon.svg

# Not read at runtime: the bundles are self-contained.
client/package.json
server/package.json

# Ship only the esbuild bundles. Allowlist so new tsc output directories cannot leak.
client/out/**
server/out/**
!client/out/extension.js
!server/out/server.js
